+<?php
+
+namespace App\Http\Controllers\Web;
+
+use App\Http\Controllers\Controller;
+use App\Services\BillingCalendarService;
+use Illuminate\Http\Request;
+
+class BillingCalendarController extends Controller
+{
+    /** Selectable forecast horizons, in months. */
+    private const MONTH_OPTIONS = [3, 6, 12, 24];
+
+    public function index(Request $request, BillingCalendarService $calendar)
+    {
+        $months = (int) $request->query('months', 12);
+        if (! in_array($months, self::MONTH_OPTIONS, true)) {
+            $months = 12;
+        }
+
+        $schedule = $calendar->upcomingSchedule($months);
+
+        return view('billing.calendar', array_merge($schedule, [
+            'monthOptions' => self::MONTH_OPTIONS,
+        ]));
+    }
+}
diff --git a/app/Services/BillingCalendarService.php b/app/Services/BillingCalendarService.php
new file mode 100644
index 0000000..cbbabbd
--- /dev/null
+++ b/app/Services/BillingCalendarService.php
@@ -0,0 +1,142 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\RecurringInvoiceProfile;
+use Illuminate\Support\Carbon;
+
+/**
+ * Projects the upcoming recurring-invoice generation schedule from the
+ * `next_run_date` on each active recurring profile, stepping forward by the
+ * profile's billing period the same way BillingService::advanceNextRunDate()
+ * does after a real generation.
+ *
+ * Powers the billing calendar page — a cashflow-forecasting view of when the
+ * next invoices are due to be cut and roughly how much they will be for.
+ */
+class BillingCalendarService
+{
+    /**
+     * Hard cap on projected occurrences per profile. Guards against a runaway
+     * loop if a badly-overdue monthly profile has to be stepped forward many
+     * times to reach the horizon. 600 monthly steps = 50 years — far beyond
+     * any real horizon, so it never truncates legitimate output.
+     */
+    private const MAX_OCCURRENCES_PER_PROFILE = 600;
+
+    public function __construct(
+        private readonly BillingService $billingService,
+    ) {}
+
+    /**
+     * Build the projected schedule over the next $months months.
+     *
+     * Returns an overdue bucket (profiles whose next_run_date is already in the
+     * past and awaiting generation) plus the future occurrences grouped by
+     * calendar month, with an estimated amount per occurrence.
+     */
+    public function upcomingSchedule(int $months = 12): array
+    {
+        $today = today();
+        $horizonEnd = $today->copy()->addMonths($months);
+
+        $profiles = RecurringInvoiceProfile::query()
+            ->where('is_active', true)
+            ->whereHas('contract', fn ($q) => $q->active()->psaManaged())
+            ->with(['contract.client', 'lines.sku'])
+            ->get();
+
+        $overdue = [];
+        $upcoming = [];
+
+        foreach ($profiles as $profile) {
+            // No date, or the first run is beyond the horizon → nothing to show.
+            if (! $profile->next_run_date || $profile->next_run_date->gt($horizonEnd)) {
+                continue;
+            }
+
+            // One preview per profile — the subtotal is quantity × price and does
+            // not depend on the invoice date, so it is a stable estimate for every
+            // occurrence of this profile within the horizon.
+            $preview = $this->billingService->previewInvoice($profile);
+            $estimate = (float) ($preview['subtotal'] ?? 0);
+            $wouldSkip = (bool) ($preview['would_skip'] ?? false);
+
+            $intervalMonths = max(1, $profile->billing_period->months());
+            $date = $profile->next_run_date->copy();
+
+            for ($step = 0; $step < self::MAX_OCCURRENCES_PER_PROFILE && $date->lte($horizonEnd); $step++) {
+                $isOverdue = $date->lt($today);
+
+                $occurrence = [
+                    'date' => $date->copy(),
+                    'is_overdue' => $isOverdue,
+                    'estimate' => $estimate,
+                    'would_skip' => $wouldSkip,
+                    'profile' => $profile,
+                ];
+
+                if (! $isOverdue) {
+                    $upcoming[] = $occurrence;
+                } elseif ($step === 0) {
+                    // Only the current (first) scheduled date is surfaced as overdue.
+                    // Any earlier missed cycles are represented by this single pending
+                    // row rather than a pile of past dates.
+                    $overdue[] = $occurrence;
+                }
+
+                $date = $date->copy()->addMonths($intervalMonths);
+            }
+        }
+
+        $chronological = fn (array $a, array $b) => $a['date']->getTimestamp() <=> $b['date']->getTimestamp();
+        usort($overdue, $chronological);
+        usort($upcoming, $chronological);
+
+        return [
+            'months' => $months,
+            'today' => $today,
+            'horizon_end' => $horizonEnd,
+            'overdue' => $overdue,
+            'by_month' => $this->groupByMonth($upcoming),
+            'overdue_count' => count($overdue),
+            'overdue_total' => array_sum(array_column($overdue, 'estimate')),
+            'upcoming_count' => count($upcoming),
+            'upcoming_total' => array_sum(array_column($upcoming, 'estimate')),
+        ];
+    }
+
+    /**
+     * Group already-chronological occurrences into calendar months, preserving
+     * order and carrying a per-month count and estimated total.
+     *
+     * @param  array<int, array<string, mixed>>  $occurrences
+     * @return array<int, array<string, mixed>>
+     */
+    private function groupByMonth(array $occurrences): array
+    {
+        $months = [];
+
+        foreach ($occurrences as $occurrence) {
+            /** @var Carbon $date */
+            $date = $occurrence['date'];
+            $key = $date->format('Y-m');
+
+            if (! isset($months[$key])) {
+                $months[$key] = [
+                    'key' => $key,
+                    'label' => $date->format('F Y'),
+                    'count' => 0,
+                    'total' => 0.0,
+                    'occurrences' => [],
+                ];
+            }
+
+            $months[$key]['count']++;
+            $months[$key]['total'] += $occurrence['estimate'];
+            $months[$key]['occurrences'][] = $occurrence;
+        }
+
+        return array_values($months);
+    }
+}
