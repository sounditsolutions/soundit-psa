+<?php
+
+namespace Tests\Feature\Billing;
+
+use App\Enums\BillingPeriod;
+use App\Enums\BillingSource;
+use App\Enums\ContractStatus;
+use App\Enums\ContractType;
+use App\Enums\QuantityType;
+use App\Models\Client;
+use App\Models\Contract;
+use App\Models\RecurringInvoiceProfile;
+use App\Models\RecurringInvoiceProfileLine;
+use App\Models\User;
+use App\Services\BillingCalendarService;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+class BillingCalendarTest extends TestCase
+{
+    use RefreshDatabase;
+
+    /**
+     * Build a Client → Contract → RecurringInvoiceProfile with a single fixed-quantity
+     * line so the estimated amount is deterministic (qty × unit_price).
+     */
+    private function makeProfile(
+        array $profileAttrs = [],
+        array $contractAttrs = [],
+        float $unitPrice = 100,
+        float $qty = 2,
+    ): RecurringInvoiceProfile {
+        $client = Client::factory()->create();
+
+        $contract = Contract::create(array_merge([
+            'client_id' => $client->id,
+            'name' => 'Managed Services',
+            'type' => ContractType::Managed,
+            'status' => ContractStatus::Active,
+            'billing_source' => BillingSource::Psa,
+            'billing_period' => BillingPeriod::Monthly,
+            'billing_day' => 1,
+            'payment_terms_days' => 30,
+            'start_date' => now()->subYear(),
+        ], $contractAttrs));
+
+        $profile = RecurringInvoiceProfile::create(array_merge([
+            'contract_id' => $contract->id,
+            'name' => 'Monthly MSP',
+            'is_active' => true,
+            'billing_period' => BillingPeriod::Monthly,
+            'billing_day' => 1,
+            'payment_terms_days' => 30,
+            'next_run_date' => today()->addDays(10),
+        ], $profileAttrs));
+
+        RecurringInvoiceProfileLine::create([
+            'profile_id' => $profile->id,
+            'description' => 'Managed workstation',
+            'unit_price' => $unitPrice,
+            'quantity_type' => QuantityType::Fixed,
+            'fixed_quantity' => $qty,
+            'is_taxable' => true,
+            'sort_order' => 0,
+        ]);
+
+        return $profile->fresh();
+    }
+
+    // ── Page rendering ──
+
+    public function test_calendar_page_loads_when_empty(): void
+    {
+        $user = User::factory()->create();
+
+        $resp = $this->actingAs($user)->get(route('billing.calendar'));
+
+        $resp->assertOk();
+        $resp->assertSee('Billing Calendar');
+        $resp->assertSee('No upcoming invoices');
+    }
+
+    public function test_future_profile_appears_with_estimated_amount(): void
+    {
+        $user = User::factory()->create();
+        $this->makeProfile(['name' => 'Acme Monthly', 'next_run_date' => today()->addDays(10)]);
+
+        $resp = $this->actingAs($user)->get(route('billing.calendar'));
+
+        $resp->assertOk();
+        $resp->assertSee('Acme Monthly');
+        $resp->assertSee('200.00'); // 2 × $100
+        $resp->assertDontSee('past next run date'); // no overdue section header
+    }
+
+    public function test_overdue_profile_is_shown_in_overdue_section(): void
+    {
+        $user = User::factory()->create();
+        $this->makeProfile(['name' => 'Late Co Retainer', 'next_run_date' => today()->subDays(5)]);
+
+        $resp = $this->actingAs($user)->get(route('billing.calendar'));
+
+        $resp->assertOk();
+        $resp->assertSee('past next run date'); // overdue section header
+        $resp->assertSee('Late Co Retainer');
+    }
+
+    // ── Filtering ──
+
+    public function test_inactive_profile_is_excluded(): void
+    {
+        $user = User::factory()->create();
+        $this->makeProfile(['name' => 'Dormant Profile', 'is_active' => false, 'next_run_date' => today()->addDays(5)]);
+
+        $resp = $this->actingAs($user)->get(route('billing.calendar'));
+
+        $resp->assertOk();
+        $resp->assertDontSee('Dormant Profile');
+    }
+
+    public function test_non_active_contract_is_excluded(): void
+    {
+        $user = User::factory()->create();
+        $this->makeProfile(
+            ['name' => 'Expired Contract Profile', 'next_run_date' => today()->addDays(5)],
+            ['status' => ContractStatus::Expired],
