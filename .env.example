APP_NAME="PSA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_CONNECTION=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=soundit_psa
# DB_USERNAME=soundit_psa
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log

# Initial admin user. AdminSeeder aborts if unset. Set, run the seeder, then
# you can remove these from .env to keep credentials out of the env file.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=https://your-psa-domain/auth/microsoft/callback

PLIVO_WEBHOOK_SECRET=

# GRAPH_REQUEST_TIMEOUT=15
# GRAPH_TOKEN_TIMEOUT=10

AI_PROVIDER=anthropic
AI_API_KEY=
# AI_MODEL=

# Stamped as CustomerMemo on NON-recurring invoices at QBO push time so a
# payment processor's memo skip rule can exclude them from autopay.
# Customer-visible on the QBO invoice, appended below any memo entered in
# QBO; empty disables stamping. The wording may span several lines but must
# NOT contain a blank line — a blank line is the separator in the retired list
# below, so a wording holding one could never be retired as itself; such a
# value is logged and not stamped instead of being stamped un-retirably.
# QBO_NONRECURRING_SKIP_MEMO="Not auto-charged - pay by check or portal"
#
# Wordings stamped previously, SEPARATED BY A BLANK LINE. In .env that means
# REAL line breaks inside the double-quoted value, with an empty line between
# two wordings, as in the example below. A wording may itself span several
# lines, so a single line break is a break INSIDE one wording, never a
# separator between two — listing them one per line would make each line of a
# multi-line wording removable on its own and delete operator-typed memo text
# that matches one. A `\n` escape is not expanded by phpdotenv — it either
# fails to boot or carries through as the two literal characters, which are
# read as a line break inside a wording, so `\n\n` separates two. Commas are
# never separators: the line above is free-form prose and may itself contain
# one. A QBO update rewrites the whole memo, so an old stamp is removable only
# while it is still listed: when changing or clearing the line above, move the
# old wording here or already-stamped invoices keep it forever. Uncomment ALL
# THREE lines below — the middle one becomes the blank separator line:
# QBO_NONRECURRING_SKIP_MEMO_RETIRED="Not auto-charged - pay by check
#
# Not auto-charged, pay by check or portal"
